    private static void sendCommand(Writer writer, String command) throws IOException {
        writer.write(command);
        writer.flush();
    }

    private static String readUntil2(BufferedReader reader, String pattern) throws IOException {
        StringBuilder builder = new StringBuilder();
        // char lastChar = pattern.charAt(pattern.length() - 1);
        char[] buffer = new char[1024];
        int read = 0;
        while ((read = reader.read(buffer)) != -1) {

            builder.append(buffer, 0, read);

            System.out.println(new String(buffer, 0, read));

            if (builder.length() >= pattern.length()) {
                String end = builder.substring(builder.length() - pattern.length());

                if (end.equals(pattern)) {
                    break;
                }
            }
        }

        return builder.toString();
    }

    private static String readUntil(BufferedReader reader, String pattern) throws IOException {
        StringBuilder builder = new StringBuilder();
        char[] buffer = new char[1024];
        int read;

        while ((read = reader.read(buffer)) != -1) {
            builder.append(buffer, 0, read);

            // (선택) 방금 받은 것 그대로 콘솔로 보기
            // System.out.print(new String(buffer, 0, read));

            // ---- 핵심 변경: 끝부분 느슨 매칭 ----
            int tailLen = Math.min(512, builder.length());
            String tail = builder.substring(builder.length() - tailLen);

            int idx = tail.lastIndexOf(pattern);
            if (idx != -1) {
                String after = tail.substring(idx + pattern.length());
                // 패턴 뒤에 공백/제어문자만 있으면 프롬프트로 인정
                if (after.replaceAll("\\p{Cntrl}", "").trim().isEmpty()) {
                    // (디버그) 마지막 몇 글자와 코드 출력
                    // System.out.println("[DEBUG] matched tail: [" + tail.substring(Math.max(0, idx
                    // - 10)) + "]");
                    for (int i = Math.max(0, tail.length() - 10); i < tail.length(); i++) {
                        char c = tail.charAt(i);
                        // System.out.printf("[DEBUG] tail[%d] char='%s' (code=%d)%n",i, (c == '\r' ?
                        // "\\r" : c == '\n' ? "\\n" : String.valueOf(c)), (int) c);
                    }
                    break;
                }
            }
            // ------------------------------------
        }

        return builder.toString();
    }

    private static String gettime() {
        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");

        Date now = new Date();
        String date = sdf.format(now);
        return date;
    }

    private static void saveResult(String switchIp, String fileName, String result) throws IOException {
        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");

        Date now = new Date();
        String date = sdf.format(now);
        String filenm = date + "_" + switchIp + "_" + fileName;
        total_result += "--------------" + filenm + "-----------------\n";
        total_result += result + "\n";

        Path directoryPath = Paths.get(".\\cisco\\" + date);

        try {
            // 디렉토리 생성
            Files.createDirectories(directoryPath);

            // System.out.println(directoryPath + " 디렉토리가 생성되었습니다.");
        } catch (IOException e) {
            e.printStackTrace();
        }
        try {
            BufferedWriter writer = new BufferedWriter(new FileWriter(".\\cisco\\" + date + "\\" + filenm));
            writer.write(result);
            writer.close();
            System.out.println(switchIp + ": " + fileName + " saved successfully");
        } catch (java.io.FileNotFoundException e) {
            total_result += e.getMessage();
            System.out.println(switchIp + ": " + fileName + " saved Fail");
        }

    }

    private static List<String[]> readlist(String csvFile) {
        String line;
        List<String[]> firstColumnList = new ArrayList<>();

        try (BufferedReader br = new BufferedReader(new FileReader(csvFile))) {
            while ((line = br.readLine()) != null) {
                if (!line.startsWith("#") && !line.trim().isEmpty()) {
                    String[] temp = line.split(",");

                    // 중복 확인: 리스트 안에 동일한 항목이 이미 있으면 추가하지 않음
                    boolean isDuplicate = false;
                    for (String[] existing : firstColumnList) {
                        if (Arrays.equals(existing, temp)) {
                            isDuplicate = true;
                            break;
                        }
                    }

                    if (!isDuplicate) {
                        firstColumnList.add(temp);
                    }
                }
            }
        } catch (IOException e) {
            e.printStackTrace();
        }

        return firstColumnList;
    }

    // ✅ IP 주소 정렬 로직
    private static void sortByIPAddress(List<String[]> list) {
        list.sort((a, b) -> {
            String[] ipA = a[0].split("\\.");
            String[] ipB = b[0].split("\\.");

            for (int i = 0; i < 4; i++) {
                int valA = Integer.parseInt(ipA[i]);
                int valB = Integer.parseInt(ipB[i]);
                if (valA != valB)
                    return valA - valB;
            }
            return 0;
        });
    }

    // ✅ 정렬된 결과를 파일로 저장
    private static void writeListToFile(String csvFile, List<String[]> list) {
        try (BufferedWriter bw = new BufferedWriter(new FileWriter(csvFile))) {
            for (String[] row : list) {
                bw.write(String.join(",", row));
                bw.newLine();
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

}
