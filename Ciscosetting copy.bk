    private static void checkstatus() {
        try (ServerSocket serverSocket = new ServerSocket(DUM_PORT)) { // 포트를 점유하여 실행 중인지 확인
            System.out.println("프로그램 실행 중...");
        } catch (IOException e) {
            System.out.println("이미 실행 중인 인스턴스가 있습니다. 종료합니다.");
            try {
                System.exit(1);
            } catch (Exception e1) {
                // TODO Auto-generated catch block
                e1.printStackTrace();
            }
        }
    }

